# GuardianX frontend environment.
# Copy to `.env` (optional) and adjust before `npm run dev` / `npm run build`.

# ---- REQUIRED (deployment only) ----
# Base URL of the GuardianX backend API.
#   Native development (default when unset):
#     http://127.0.0.1:8000/api
#   Docker Compose: /api  (nginx inside the frontend container proxies /api
#     to the backend service; set at image build time by the compose file).
VITE_API_URL=http://127.0.0.1:8000/api
