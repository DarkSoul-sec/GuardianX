APP_NAME=GuardianX
APP_VERSION=1.0.0
API_PREFIX=/api

# Authentication mode for this deployment.
#   local: first-run administrator setup, no public signup, no email
#          verification gate, SMTP is not a startup requirement.
#   cloud: public signup with email verification (multi-user / Cloud).
AUTH_MODE=local

# Public base URL used to build email verification / password-reset links.
# Must point at the deployed frontend origin (no trailing slash).
# In development this is the Vite dev server origin.
# In Docker this is http://localhost:8080 (set by the compose file).
PUBLIC_APP_URL=http://localhost:5173

DEBUG=True

HOST=127.0.0.1
PORT=8000

# ---- Database (least-privilege, three-role model) ----
# GuardianX runs against PostgreSQL with three separate roles:
#   bootstrap  (superuser, provisioning only - you create this yourself)
#   guardianx_migrate (owns the database; used ONLY for `alembic upgrade head`)
#   guardianx_app     (restricted runtime role - THIS is what the app uses)
#
# The app must NEVER run as a PostgreSQL superuser.
# See docs/DEVELOPMENT.md for one-time setup:
#   infrastructure/scripts/provision_dev_db.sh
#
# DATABASE_USER is the runtime application role (DML only, no DDL).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=guardianx
DATABASE_USER=guardianx_app
DATABASE_PASSWORD=your_app_role_password_here
# Migration role credentials (used only when running alembic directly):
#   DATABASE_USER=guardianx_migrate DATABASE_PASSWORD=<migrate password> .venv/bin/alembic upgrade head

# ---- Auth / JWT ----
# REQUIRED. Long random string used to sign JWTs. Generate one with:
#   openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# Comma-separated list of browser origins allowed to call the API.
# In development this is the Vite dev server origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Email delivery (optional) ----
# When EMAIL_SMTP_HOST is empty, emails are logged to the console instead of
# sent. This is fine for local development. In production (DEBUG=false) SMTP is
# REQUIRED and the app fails fast at startup if it is missing.
# Use STARTTLS (port 587, EMAIL_USE_TLS=true) or implicit SSL (port 465,
# EMAIL_USE_SSL=true), never both.
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=apikey
# Resend example (implicit SSL on 465):
# EMAIL_SMTP_HOST=smtp.resend.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER=resend
# EMAIL_SMTP_PASSWORD=re_<your_resend_api_key>
# EMAIL_USE_TLS=false
# EMAIL_USE_SSL=true
# EMAIL_FROM=GuardianX <noreply@your-verified-resend-domain.com>
# EMAIL_SMTP_PASSWORD=your_smtp_password
# EMAIL_FROM=GuardianX <noreply@example.com>
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_SMTP_TIMEOUT_SECONDS=15
# EMAIL_VERIFICATION_EXPIRE_MINUTES=60
# PASSWORD_RESET_EXPIRE_MINUTES=30

# ---- Scan execution ----
# Concurrency for scan execution.
# SCAN_MAX_WORKERS=3

# LOCAL DEVELOPMENT ONLY:
# When enabled, private, loopback, link-local and reserved address targets
# are permitted and logged instead of blocked. Disables SSRF / internal-scan
# protection — keep OFF (default) in any public deployment.
# ALLOW_PRIVATE_NETWORK_SCANS=true

# ---- Logging ----
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_FORMAT: json (structured, recommended for production) | text
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# ---- AI Copilot ----
# Provider auto-selected when unset: openai (if key set) -> gemini (if key set) -> rules (built-in)
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# ---- VirusTotal Intelligence (Bring Your Own API Key) ----
# VirusTotal uses a per-user BYOAPI model: each user adds their own API key
# in Settings > Integrations > VirusTotal. No shared key is stored in .env.
# VIRUSTOTAL_API_URL=https://www.virustotal.com/api/v3
# VIRUSTOTAL_TIMEOUT_SECONDS=15
# VIRUSTOTAL_MAX_RETRIES=3
# Client-side burst requests per minute sent to the VT API (per user key).
# VIRUSTOTAL_RATE_LIMIT_PER_MINUTE=60
# In-process response cache.
# VIRUSTOTAL_CACHE_TTL_SECONDS=900
# VIRUSTOTAL_CACHE_MAX_ENTRIES=512

# ---- Threat Intelligence platform ----
# Cached VirusTotal reports are served for 24 hours by default to keep lookups
# within BYOAPI quotas. Lower TTLs trade quota for fresher vendor verdicts.
# INTELLIGENCE_CACHE_TTL_SECONDS=86400
# INTELLIGENCE_CACHE_MAX_ENTRIES=2048

# ---- Phishing Detection ----
# Comma-separated keyword/TLD/blacklist/trusted-domain lists. Empty values
# use the defaults in app/detection/phishing/config.py.
# PHISHING_SUSPICIOUS_KEYWORDS=login,verify,account,password,billing
# PHISHING_TRUSTED_DOMAINS=example.com,acme-corp.com
# PHISHING_BLACKLIST_SERVERS=zen.spamhaus.org,dbl.spamhaus.org
# PHISHING_RISKY_TLDS=tk,ml,ga,cf,zip,click,top,xyz
# Scoring overrides, comma-separated "check:weight" pairs.
# PHISHING_SCORE_WEIGHTS=virustotal:30,blacklist:10
# Risk thresholds medium,high,critical.
# PHISHING_RISK_THRESHOLDS=25,50,75
# PHISHING_NEW_DOMAIN_DAYS=90
# PHISHING_SUSPICIOUS_DOMAIN_DAYS=365
# PHISHING_CERTIFICATE_RENEW_DAYS=30
# PHISHING_NETWORK_TIMEOUT_SECONDS=10
# PHISHING_AI_SUMMARY_ENABLED=True

# ---- Threat Intelligence Center ----
# Sources default to the public NVD / CISA / FIRST endpoints. Override to
# point at proxies or self-hosted mirrors of the same feeds.
# THREAT_INTEL_NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
# THREAT_INTEL_KEV_API_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# THREAT_INTEL_EPSS_API_URL=https://api.first.org/data/v1/epss
# THREAT_INTEL_TIMEOUT_SECONDS=15
# THREAT_INTEL_CACHE_TTL_SECONDS=1800
# THREAT_INTEL_MAX_RESULTS=200
