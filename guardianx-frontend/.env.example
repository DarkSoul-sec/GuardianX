# GuardianX frontend environment.
# Copy to `.env` (optional) and adjust before `npm run dev` / `npm run build`.

# ---- REQUIRED (deployment only) ----
# Base URL of the GuardianX backend API.
#   Native development: http://127.0.0.1:8000/api  (Vite dev-server proxy
#     also forwards /api -> backend:8000, so an unset value just needs /api).
#   Docker Compose: /api  (nginx inside the frontend container proxies /api
#     to the backend service; set at image build time by the compose file).
#
# If left UNSET or EMPTY, the frontend resolves the base URL to a relative
# "/api" so requests always carry the /api prefix (required by the backend
# router). Do NOT leave this unset for production builds behind a real proxy
# host -- set it explicitly to the public API origin if different.
VITE_API_URL=http://127.0.0.1:8000/api
