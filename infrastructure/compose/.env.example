# GuardianX deployment configuration.
# Copy to `.env` and adjust before running `docker compose up -d`.
# NEVER commit the real `.env` (it contains secrets).

# ---- REQUIRED ----
# A long, random secret used to sign JWTs. Generate one with:
#   openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# ---- Postgres (three-role model) ----
# All three passwords are REQUIRED and MUST be unique, random strings.
# The stack refuses to start while any of them is missing, a placeholder, or
# shorter than 16 characters.
# Generate with: openssl rand -hex 32
POSTGRES_DB=guardianx

# Bootstrap administrator (SUPERUSER). Used ONLY during initial provisioning
# to create roles and grants. NEVER used by the running application.
POSTGRES_USER=guardianx
POSTGRES_PASSWORD=change-me-in-production

# Migration role: owns the GuardianX database, used ONLY for `alembic upgrade
# head`. NOSUPERUSER / NOCREATEDB / NOCREATEROLE / NOREPLICATION / NOBYPASSRLS.
POSTGRES_MIGRATE_USER=guardianx_migrate
POSTGRES_MIGRATE_PASSWORD=change-me-generate-a-strong-password

# Application role: restricted runtime role used by the FastAPI app. DML only,
# no DDL, no superuser attributes. NEVER grant it more than it needs.
POSTGRES_APP_USER=guardianx_app
POSTGRES_APP_PASSWORD=change-me-generate-a-strong-password

# ---- App ----
# Authentication mode: local (default, first-run admin setup, no public
# signup, SMTP not required) or cloud (public signup + email verification).
AUTH_MODE=local
# DEBUG=true lets the stack start without a configured SMTP server (email is
# logged to the backend console). Cloud mode requires SMTP when DEBUG=false.
DEBUG=true
# Public origin users visit. Used to build email verification / reset links.
PUBLIC_APP_URL=http://localhost:8080
# Comma-separated CORS origins (the frontend origin).
CORS_ORIGINS=http://localhost:8080

# ---- Ports ----
# Host port that maps to the web UI.
HTTP_PORT=8080

# ---- Email (optional; empty disables sending and logs to console) ----
# Required in production (DEBUG=false). Use STARTTLS (port 587, EMAIL_USE_TLS=true)
# or implicit SSL (port 465, EMAIL_USE_SSL=true), never both.
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=apikey
# EMAIL_SMTP_PASSWORD=your_smtp_password
# EMAIL_FROM=GuardianX <noreply@example.com>
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_SMTP_TIMEOUT_SECONDS=15
